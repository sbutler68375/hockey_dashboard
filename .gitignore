# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Environment / secrets
.env

# Raw pulls are regenerated by collectors, not committed. The database and
# trained models ARE committed: the hosted dashboard (Streamlit Community
# Cloud) reads them straight from the repo.
data/raw/*
data/processed/*
data/exports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep

# Models (large binary artifacts) -- except the two saved ratings models
models/*.pkl
models/*.joblib
!models/team_ratings.joblib
!models/player_ratings.joblib

# OS/editor
.vscode/
.DS_Store
